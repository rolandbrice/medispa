---
import type { Lang } from '../lib/i18n';
import { nocturnesAVenir, texteBanniere } from '../lib/nocturnes';
import { chemin } from '../lib/routes';
import { site } from '../lib/site';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
// Une bannière par nocturne à venir au moment du build, seule la première visible.
// scripts/nocturnes.ts retire les passées côté navigateur et affiche la suivante.
const avenir = nocturnesAVenir(site.nocturnes, new Date());
---
{avenir.map((n, i) => (
  <div data-banniere-nocturne data-fin={n.fin} hidden={i > 0} class="bg-profond px-4 py-2 text-center text-[14px] text-white">
    {texteBanniere(n, lang)}
    <a href={chemin('reserver', lang)} class="ml-2 underline underline-offset-4">{_('nocturnes.reserver')}</a>
  </div>
))}
