---
// Photo de la façade ; au clic, elle laisse place à la carte Google (aucun script tiers au chargement).
import type { Lang } from '../lib/i18n';
import { site } from '../lib/site';
import { t } from '../i18n/ui';
import Photo from './Photo.astro';
import facade from '../assets/photos/facade.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const src = `https://www.google.com/maps?q=${encodeURIComponent(site.requeteMaps)}&hl=${lang}&output=embed`;
---
<div class="carte-maps relative aspect-[4/3] w-full overflow-hidden rounded-3xl bg-brume" data-src={src} data-titre={`Google Maps, ${site.nom}`}>
  <Photo src={facade} alt={_('photo.facade')} sizes="(min-width: 1024px) 560px, 100vw" class="absolute inset-0" imgClass="object-[center_40%]" />
  <div class="absolute inset-x-0 bottom-0 flex flex-wrap items-center gap-x-4 gap-y-2 bg-gradient-to-t from-profond/85 to-transparent p-5 pt-16 text-white">
    <button type="button" class="bouton-clair">{_('contact.carte')}</button>
    <span class="text-sm text-ecume">{_('contact.carteNote')}</span>
  </div>
</div>

<script>
  import '../scripts/carte-maps';
</script>
