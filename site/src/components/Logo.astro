---
// L'enseigne de la façade (« Medi » + « Spa » script + visage au trait), décalquée et vectorisée.
// Un seul fichier SVG en cache, coloré par la couleur du texte grâce au masque CSS `.logo`.
interface Props { class?: string; label?: string }
const { class: cls = 'w-[170px]', label = 'Medi Spa' } = Astro.props;
---
<span class:list={['logo', cls]} role="img" aria-label={label}></span>
