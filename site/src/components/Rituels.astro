---
import { getCollection } from 'astro:content';
import type { Lang } from '../lib/i18n';
import { formaterPrix } from '../lib/prix';
import { chemin } from '../lib/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const rituels = (await getCollection('rituels')).sort((a, b) => a.data.ordre - b.data.ordre);
---
<section id="rituels" class="scroll-mt-6 bg-eau-pale py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <h2 class="text-5xl md:text-6xl">{_('rituels.titre')}</h2>
    <p class="mt-3 max-w-[48ch] text-doux">{_('rituels.intro')}</p>
    <ul class="mt-12 grid gap-12 md:grid-cols-3 md:gap-0">
      {rituels.map((r, i) => (
        <li class:list={['flex flex-col md:px-8', i === 0 ? 'md:pl-0' : 'md:border-l md:border-profond/15', i === rituels.length - 1 && 'md:pr-0']}>
          <h3 class="text-3xl leading-tight">{r.data.nom[lang]}</h3>
          <p class="mt-1 text-doux">{r.data.duree}</p>
          <ul class="mt-5 flex-1 space-y-1.5">
            {r.data.contenu[lang].map((c) => <li>{c}</li>)}
          </ul>
          <p class="mt-6 font-serif text-2xl">{formaterPrix(r.data.prix, lang)}</p>
          <a href={`${chemin('reserver', lang)}?soin=${r.id}`} class="bouton mt-5 self-start">{_('cta.reserver')}</a>
        </li>
      ))}
    </ul>
  </div>
</section>
