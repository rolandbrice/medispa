---
import { getCollection } from 'astro:content';
import type { Lang } from '../../lib/i18n';
import { formaterMois } from '../../lib/horaires';
import { site } from '../../lib/site';
import { t } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
// Uniquement des avis Google recopiés mot pour mot (voir content.config.ts).
const avis = (await getCollection('avis')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
const guillemets = (l: Lang, s: string) => (l === 'fr' ? `« ${s} »` : `“${s}”`);
---
<section class="mx-auto max-w-[900px] px-5 py-20 md:py-28">
  <h2 class="text-5xl md:text-6xl">{_('avis.titre')}</h2>
  {avis.length > 0 && (
    <div class="mt-10 space-y-12">
      {avis.map((a) => (
        <figure>
          <blockquote class="font-serif text-2xl leading-snug md:text-[1.75rem]" lang={a.data.langue}>{guillemets(a.data.langue, a.data.texte)}</blockquote>
          <figcaption class="mt-4 text-doux">{a.data.auteur}, {formaterMois(a.data.date, lang)}, {_('avis.source')}</figcaption>
        </figure>
      ))}
    </div>
  )}
  <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4">
    <a href={site.ficheGoogle} target="_blank" rel="noopener" class="bouton">{_('avis.tous')}</a>
    <a href={site.lienAvisGoogle} target="_blank" rel="noopener" class="lien">{_('avis.laisser')}</a>
  </div>
</section>
