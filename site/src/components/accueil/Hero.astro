---
import type { Lang } from '../../lib/i18n';
import { resumerHoraires } from '../../lib/horaires';
import { chemin } from '../../lib/routes';
import { site } from '../../lib/site';
import { remplir, t } from '../../i18n/ui';
import Photo from '../Photo.astro';
import haut from '../../assets/photos/hero.jpg';
import bas from '../../assets/photos/cabine-arche.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const note = new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB').format(site.note);
---
<section class="bg-eau px-5 pb-20 pt-6 text-center text-profond md:pb-24 md:pt-10">
  <!-- Le sablier de l'affiche des Nocturnes : deux demi-disques de photo, le titre à la taille -->
  <div class="mx-auto w-full max-w-[460px]">
    <Photo src={haut} alt={_('photo.hero')} forme="demi-haut" prioritaire sizes="(min-width: 500px) 460px, 100vw" widths={[460, 920]} class="aspect-[2/1] bg-eau-trait" />
    <h1 class="mx-auto my-6 max-w-[13ch] text-[2.5rem] leading-[1.03] text-profond sm:text-6xl md:my-7 md:text-[4.3rem]">{_('hero.titre')}</h1>
    <Photo src={bas} alt={_('photo.cabine')} forme="demi-bas" sizes="(min-width: 500px) 460px, 100vw" widths={[460, 740]} class="aspect-[2/1] bg-eau-trait" />
  </div>
  <p class="mx-auto mt-9 max-w-[34ch] text-lg text-profond-trait">{_('hero.lieu')} {resumerHoraires(site.horaires, lang)}</p>
  <div class="mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
    <a href={chemin('reserver', lang)} class="bouton">{_('cta.reserverSoin')}</a>
    <a href="#soins" class="lien">{_('cta.voirSoins')}</a>
  </div>
  <p class="mt-6 text-[15px] text-profond-trait">
    <a href={site.ficheGoogle} target="_blank" rel="noopener" class="hover:text-profond hover:underline">{remplir(_('note.google'), { note, n: site.nbAvis })}</a>
  </p>
</section>
