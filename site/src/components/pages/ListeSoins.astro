---
import { getCollection } from 'astro:content';
import type { Lang } from '../../lib/i18n';
import { formaterPrix, nomTarif } from '../../lib/prix';
import { chemin } from '../../lib/routes';
import { schemaFilAriane } from '../../lib/schema-org';
import { site } from '../../lib/site';
import { t } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import FilAriane from '../FilAriane.astro';
import Rituels from '../Rituels.astro';
import TeaserCadeau from '../TeaserCadeau.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const soins = (await getCollection('soins')).sort((a, b) => a.data.ordre - b.data.ordre);
const base = Astro.site!.href;
const etapes = [
  { nom: _('fil.accueil'), href: chemin('accueil', lang) },
  { nom: _('soins.carte'), href: chemin('soins', lang) },
];
const schemas = [schemaFilAriane(etapes.map((e) => ({ nom: e.nom, url: new URL(e.href, base).href })))];
---
<Base lang={lang} page="soins" titre={_('meta.soins.titre')} description={_('meta.soins.description')} schemas={schemas}>
  <section class="mx-auto max-w-[900px] px-5 pb-20 pt-8 md:pb-28 md:pt-12">
    <FilAriane lang={lang} etapes={etapes} />
    <h1 class="mt-8 text-5xl md:text-7xl">{_('soins.carte')}</h1>
    {site.demo && <p class="mt-3 text-sm text-doux">{_('soins.demo')}</p>}

    <div class="mt-12 border-t border-brume">
      {soins.map((s) => (
        <article class="grid gap-x-10 gap-y-4 border-b border-brume py-10 md:grid-cols-[5fr_6fr]">
          <div>
            <h2 class="text-3xl leading-tight md:text-4xl"><a href={chemin('soin', lang, s.id)} class="hover:underline hover:decoration-2 hover:underline-offset-8">{s.data.titre[lang]}</a></h2>
            <p class="mt-2 text-doux">{s.data.accroche[lang]}</p>
          </div>
          <ul class="md:pt-1">
            {s.data.tarifs.map((tarif) => (
              <li class="flex items-baseline justify-between gap-6 border-b border-brume py-2.5 last:border-0">
                <span>{nomTarif(tarif, lang)}</span>
                <span class="whitespace-nowrap font-semibold">{formaterPrix(tarif.prix, lang)}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <a href={chemin('reserver', lang)} class="bouton mt-10">{_('cta.reserverSoin')}</a>
  </section>
  <Rituels lang={lang} />
  <TeaserCadeau lang={lang} />
</Base>
