---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import soins from '../data/soins.json';
import rituels from '../data/rituels.json';

const wa = (msg: string) => `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(msg)}`;
const title = 'MEDI-SPA Saly — Centre de bien-être à Saly Portudal | Massage, Hammam, Soins';
const description = 'MEDI-SPA Saly, noté 4,8/5 à Saly Portudal (Sénégal). Massages, soins visage & corps, hammam & gommage, épilation, amincissement. Réservez sur WhatsApp.';
---

<Base title={title} description={description} lang="fr" path="/">
  <div class="bg-sauge text-sable text-[11px] tracking-[.25em] uppercase text-center py-2 px-4">
    Saly Portudal · Lun–Sam 9h–20h · <a class="underline underline-offset-2" href={wa('Bonjour MEDI-SPA Saly')}>{site.telephone}</a>
  </div>

  <header id="nav" class="sticky top-0 z-40 bg-creme/90 backdrop-blur border-b border-encre/10 transition-shadow">
    <div class="max-w-7xl mx-auto px-5 md:px-8 py-4 flex items-center justify-between">
      <a href="/" class="font-serif text-2xl leading-none">MEDI<span class="text-argile">-</span>SPA
        <span class="block font-sans font-light text-[10px] tracking-[.4em] uppercase mt-1">Saly</span>
      </a>
      <nav aria-label="Navigation principale" class="hidden md:flex gap-8 text-xs tracking-[.25em] uppercase font-light">
        <a href="#carte" class="link-line">Carte</a>
        <a href="#rituels" class="link-line">Rituels</a>
        <a href="#avis" class="link-line">Avis</a>
        <a href="#contact" class="link-line">Contact</a>
      </nav>
      <div class="flex items-center gap-3">
        <a href="/en/" lang="en" hreflang="en" aria-label="English version" class="text-[11px] tracking-[.2em] uppercase opacity-70 hover:opacity-100 transition">EN</a>
        <a href={wa('Bonjour MEDI-SPA Saly, je souhaite réserver.')} target="_blank" rel="noopener" class="btn-arrow bg-encre text-sable px-5 md:px-7 py-2.5 text-xs tracking-[.25em] uppercase hover:bg-sauge transition">Réserver <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </header>

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-5 md:px-8 pt-10 md:pt-16 pb-14 grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-6">
        <p class="hero-in text-[11px] tracking-[.35em] uppercase text-dore mb-5" style="animation-delay:.05s">Face Totem Saly · 78 595 15 15</p>
        <p class="hero-in font-serif text-2xl md:text-3xl" style="animation-delay:.1s">MÉDI-SPA <span class="italic font-light">Saly</span></p>
        <h1 class="hero-in font-serif leading-[1.02] text-5xl sm:text-6xl lg:text-[4.6rem] mt-3" style="animation-delay:.2s">
          Kiné, massage,<br />hammam, balnéo.
        </h1>
        <p class="hero-in mt-6 font-light text-base md:text-lg text-encre/70 max-w-md" style="animation-delay:.32s">
          Centre de bien-être à Saly Portudal. Nocturnes vendredis & samedis, 18h–21h.
        </p>
        <div class="hero-in mt-8 flex flex-wrap gap-3" style="animation-delay:.44s">
          <a href={wa('Bonjour MEDI-SPA, je veux réserver.')} target="_blank" rel="noopener" class="btn-arrow bg-encre text-sable px-8 py-4 text-xs tracking-[.25em] uppercase hover:bg-sauge transition">Réserver <span class="arr" aria-hidden="true">→</span></a>
          <a href="#carte" class="px-8 py-4 text-xs tracking-[.25em] uppercase border border-encre/30 hover:bg-encre hover:text-sable transition">La carte</a>
        </div>
        <p class="hero-in mt-8 text-sm font-light text-encre/75" style="animation-delay:.54s"><span role="img" aria-label="Noté 4,8 sur 5">★</span> {site.noteGoogle} · {site.nbAvis} avis Google</p>
      </div>
      <div class="lg:col-span-6">
        <div class="hero-in frame-gold" style="animation-delay:.35s">
          <img src="/images/reelles/facade.jpg" alt="Façade MEDI-SPA Saly, Face Totem Saly" width="1280" height="718" fetchpriority="high" class="w-full h-[320px] md:h-[440px] object-cover rounded-sm" loading="eager" />
        </div>
        <p class="mt-6 text-xs tracking-[.2em] uppercase text-encre/70">Face Totem Saly — kinésithérapie, bien-être et remise en forme</p>
      </div>
    </div>
  </section>

  <!-- CARTE -->
  <section id="carte" class="max-w-5xl mx-auto px-5 md:px-8 py-20 md:py-28">
    <div class="flex items-baseline justify-between gap-6">
      <h2 class="reveal font-serif text-4xl md:text-6xl">La carte</h2>
      <p class="reveal hidden sm:block font-light text-sm text-encre/70">Prix sur WhatsApp</p>
    </div>

    <div class="mt-10 border-t border-encre/15">
      {soins.map((s, i) => (
        <a href={wa(s.messageWhatsapp)} target="_blank" rel="noopener" style={`--d:${i * 0.05}s`} class="reveal menu-row group flex items-baseline py-5 border-b border-encre/15">
          <span class="font-serif text-2xl md:text-3xl">{s.titre}</span>
          <span class="menu-dots"></span>
          <span class="text-xs tracking-[.2em] uppercase text-encre/70 whitespace-nowrap hidden sm:inline">{s.duree}</span>
          <span class="ml-4 text-argile text-xl leading-none group-hover:translate-x-1.5 transition duration-300">→</span>
        </a>
      ))}
    </div>
    <p class="reveal mt-6 font-light text-sm text-encre/55">Massage solo & duo · carte cadeau disponible.</p>
  </section>

  <!-- RITUELS -->
  <section id="rituels" class="bg-sable py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 md:px-8">
      <p class="reveal text-[11px] tracking-[.35em] uppercase text-dore text-center mb-3">Vendredis & samedis · 18h–21h</p>
      <h2 class="reveal font-serif text-4xl md:text-6xl text-center">Forfaits</h2>
      <div class="grid md:grid-cols-3 gap-5 mt-12">
        {rituels.map((r, i) => (
          <div style={`--d:${i * 0.1}s`} class={`reveal p-8 text-center rounded-sm border hover:-translate-y-1.5 transition duration-300 ${r.vedette ? 'bg-encre text-sable border-encre relative shadow-xl' : 'bg-creme border-encre/10'}`}>
            {r.vedette && <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-argile text-encre text-[10px] tracking-[.25em] uppercase px-4 py-1">Le plus demandé</span>}
            <p class="text-[11px] tracking-[.3em] uppercase text-argile">{r.duree}</p>
            <h3 class="font-serif text-3xl mt-2">{r.nom}</h3>
            <p class={`font-light text-sm mt-4 ${r.vedette ? 'text-sable/80' : 'text-encre/70'}`}>{r.contenu}</p>
            <a href={wa(`Bonjour, je souhaite le rituel ${r.nom}.`)} target="_blank" rel="noopener" class={`btn-arrow mt-6 block py-3 text-[11px] tracking-[.25em] uppercase transition ${r.vedette ? 'bg-argile text-encre hover:bg-sable' : 'border border-encre hover:bg-encre hover:text-sable'}`}>Réserver <span class="arr" aria-hidden="true">→</span></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LE LIEU -->
  <section class="max-w-7xl mx-auto px-5 md:px-8 py-20 md:py-28 grid lg:grid-cols-2 gap-10 items-center">
    <div class="grid grid-cols-3 gap-3">
      <div class="overflow-hidden rounded-sm">
        <img src="/images/massage-huile.jpg" alt="Massage" class="reveal duo card-img h-60 md:h-80 w-full object-cover" loading="lazy" />
      </div>
      <div class="overflow-hidden rounded-sm">
        <img src="/images/hammam.jpg" alt="Hammam" style="--d:.1s" class="reveal duo card-img h-60 md:h-80 w-full object-cover" loading="lazy" />
      </div>
      <div class="overflow-hidden rounded-sm">
        <img src="/images/soin-visage.jpg" alt="Soin visage" style="--d:.2s" class="reveal duo card-img h-60 md:h-80 w-full object-cover" loading="lazy" />
      </div>
    </div>
    <div>
      <p class="reveal text-[11px] tracking-[.35em] uppercase text-dore mb-3">Face Totem Saly</p>
      <h2 class="reveal font-serif text-4xl md:text-5xl leading-tight">Une adresse,<br />pas un concept.</h2>
      <ul class="mt-8 space-y-4 font-light text-[15px]">
        <li class="reveal">Linge frais, protocoles stricts, matériel désinfecté.</li>
        <li class="reveal" style="--d:.1s">Kinésithérapie, remise en forme, soins toutes peaux.</li>
        <li class="reveal" style="--d:.2s">Français et anglais, Face Totem Saly.</li>
      </ul>
      <div class="reveal mt-8 flex gap-10" style="--d:.25s">
        <div><p class="font-serif text-5xl">{site.noteGoogle}</p><p class="text-[10px] tracking-[.25em] uppercase text-encre/70 mt-1">Sur Google</p></div>
        <div><p class="font-serif text-5xl">{site.nbAvis}</p><p class="text-[10px] tracking-[.25em] uppercase text-encre/70 mt-1">Avis clients</p></div>
      </div>
    </div>
  </section>

  <!-- NOCTURNES -->
  <section id="nocturnes" class="bg-encre text-sable py-20 md:py-24 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-5 md:px-8 grid lg:grid-cols-2 gap-10 items-center">
      <div class="overflow-hidden rounded-sm order-2 lg:order-1">
        <img src="/images/reelles/affiche-nocturnes.jpg" alt="Nocturnes MEDI-SPA Saly — massage, hammam, balnéo" class="reveal card-img w-full object-cover" loading="lazy" />
      </div>
      <div class="order-1 lg:order-2">
        <p class="reveal text-[11px] tracking-[.35em] uppercase text-argile mb-3">Nocturnes · 18h–21h</p>
        <h2 class="reveal font-serif text-4xl md:text-5xl leading-tight">Le spa,<br />la nuit.</h2>
        <p class="reveal mt-5 font-light text-sable/70 max-w-md" style="--d:.1s">Massage solo & duo, hammam, balnéo. Vendredis et samedis soirs, sur réservation.</p>
        <a href={wa('Bonjour, je souhaite réserver une nocturne.')} target="_blank" rel="noopener" style="--d:.2s" class="reveal btn-arrow inline-block mt-8 bg-argile text-encre px-8 py-4 text-[11px] tracking-[.25em] uppercase font-medium hover:bg-sable transition">Réserver une nocturne <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- CITATION -->
  <section class="relative h-[42vh] md:h-[55vh] overflow-hidden">
    <img src="/images/plage-saly.jpg" alt="Saly" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-encre/55"></div>
    <div class="relative h-full max-w-7xl mx-auto px-5 md:px-8 flex flex-col justify-center text-sable">
      <p class="reveal font-serif text-3xl md:text-5xl max-w-2xl italic">« Après la plage, le hammam. »</p>
    </div>
  </section>

  <!-- AVIS -->
  <section id="avis" class="bg-encre text-sable py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 md:px-8">
      <h2 class="reveal font-serif text-4xl md:text-5xl text-center">{site.nbAvis} avis, {site.noteGoogle} sur Google</h2>
      <div class="grid md:grid-cols-3 gap-5 mt-12">
        {[
          'Accueil adorable, massage parfait, lieu très propre. Mon adresse à Saly.',
          'Hammam et gommage au top, on ressort légère. Je recommande.',
          'Épilation rapide et soignée, très pro. Réservation facile sur WhatsApp.',
        ].map((t, i) => (
          <figure style={`--d:${i * 0.1}s`} class="reveal bg-sable/[.07] border border-sable/15 p-7 rounded-sm hover:bg-sable/[.12] transition duration-300">
            <div class="text-argile tracking-[.2em]" aria-hidden="true">★★★★★</div>
            <blockquote class="font-serif text-lg mt-3 italic">« {t} »</blockquote>
          </figure>
        ))}
      </div>
      <div class="reveal text-center mt-10">
        <a href={site.ficheGoogle} target="_blank" rel="noopener" class="btn-arrow inline-block bg-argile text-encre px-8 py-3.5 text-[11px] tracking-[.25em] uppercase font-medium hover:bg-sable transition">Voir sur Google <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- INFOS -->
  <section class="max-w-4xl mx-auto px-5 md:px-8 py-20">
    <h2 class="reveal font-serif text-4xl md:text-5xl text-center">Bon à savoir</h2>
    <div class="mt-10 space-y-3">
      {[
        ['Réservation', `WhatsApp au ${site.telephone}. Le soir et le week-end, réservez à l'avance.`],
        ['Paiement', 'Espèces, Wave, Orange Money. Carte cadeau disponible.'],
        ['Langues', 'Français et anglais.'],
        ['Peau et soleil', 'Diagnostic offert, soins adaptés à toutes les peaux.'],
      ].map(([q, a]) => (
        <details class="reveal group bg-white border border-encre/10 rounded-sm px-6 py-5">
          <summary class="cursor-pointer font-serif text-xl list-none flex justify-between items-center gap-4">{q}<span class="text-argile group-open:rotate-45 transition text-2xl leading-none shrink-0">+</span></summary>
          <p class="font-light text-sm text-encre/70 mt-3">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="bg-sable py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 md:px-8 grid lg:grid-cols-2 gap-10">
      <div>
        <p class="reveal text-[11px] tracking-[.35em] uppercase text-dore mb-3">Contact</p>
        <h2 class="reveal font-serif text-4xl md:text-5xl">À deux pas<br />de la plage.</h2>
        <div class="reveal mt-8 space-y-2.5 font-light text-[15px]">
          <p>{site.adresse}</p>
          <p><a href={`tel:${site.telephone.replace(/\s/g, '')}`} class="border-b border-argile">{site.telephone}</a></p>
          <p><a href={`mailto:${site.email}`} class="border-b border-argile">{site.email}</a></p>
          <p><a href={site.instagram} target="_blank" rel="noopener" class="border-b border-argile">@medi_spa_saly</a></p>
          <p class="text-encre/70">{site.horaires}</p>
        </div>
      </div>
      <form id="resa" class="reveal bg-white border border-encre/10 p-7 md:p-9 rounded-sm h-fit" style="--d:.15s">
        <h3 class="font-serif text-2xl md:text-3xl">Réserver</h3>
        <label for="nom" class="block mt-6 text-[11px] tracking-[.25em] uppercase text-encre/70">Nom</label>
        <input id="nom" name="nom" required autocomplete="name" placeholder="Votre nom" class="mt-2 w-full border border-encre/20 bg-creme px-4 py-3 outline-none focus:border-argile transition text-[15px]" />
        <label for="msg" class="block mt-4 text-[11px] tracking-[.25em] uppercase text-encre/70">Soin et créneau</label>
        <textarea id="msg" name="message" required rows="3" placeholder="Massage 60 min, vendredi après-midi" class="mt-2 w-full border border-encre/20 bg-creme px-4 py-3 outline-none focus:border-argile transition text-[15px]"></textarea>
        <button class="btn-arrow mt-6 w-full bg-encre text-sable py-4 text-[11px] tracking-[.25em] uppercase hover:bg-sauge transition">Envoyer <span class="arr" aria-hidden="true">→</span></button>
      </form>
    </div>
  </section>

  <footer class="bg-encre text-sable/70 text-center py-10 px-5">
    <p class="font-serif text-xl text-sable">MEDI<span class="text-argile">-</span>SPA Saly</p>
    <p class="mt-2 text-[11px] tracking-[.25em] uppercase font-light">Massage · Hammam · Soins · Épilation</p>
  </footer>

  <script define:vars={{ numero: site.whatsapp }}>
    document.getElementById('resa')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const nom = document.getElementById('nom').value;
      const msg = document.getElementById('msg').value;
      window.open(`https://wa.me/${numero}?text=` + encodeURIComponent(`Bonjour MEDI-SPA, je suis ${nom}. Je souhaite : ${msg}`), '_blank');
    });
  </script>
</Base>
